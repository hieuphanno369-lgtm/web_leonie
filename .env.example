# ============================================================
#  Leonie — environment variables
#  Copy this file to ".env" in the repo root and fill real values.
#  .env is gitignored and must NEVER be committed.
# ============================================================

# --- AI helper (ML Studio / Action Plan) ---
# Primary: Claude API. Falls back to Ollama if ANTHROPIC_API_KEY is empty.
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Discord notifications (Discord Notify feature) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# --- Email sending (optional, SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Obsidian Local REST API (optional) ---
OBSIDIAN_BASE_URL=https://host.docker.internal:27124
OBSIDIAN_API_KEY=YOUR_OBSIDIAN_KEY

# --- Reminders / email tracker (optional) ---
REMINDER_TIME=08:00
USER_NAME=Your Name
USER_EMAIL=you@example.com
BOSS_EMAIL=manager@example.com
EMAIL_DIGEST_TIME=08:00
STYLE_RELEARN_DAY=sunday
EMAIL_QUEUE_PATH=C:\path\to\EmailQueue

# --- Automation job secrets (Salesforce / REST sources) ---
# Automation jobs reference env-var NAMES you define here, e.g.:
# SF_USER=...   SF_PASS=...   SF_TOKEN=...   MY_API_TOKEN=...
