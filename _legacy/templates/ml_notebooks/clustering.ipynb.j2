 "cells": [
  {"cell_type":"markdown","metadata":{},"source":["# Clustering: {{ dataset_name }}\n","**Features:** {{ features | join(', ') }}  **Generated:** {{ timestamp }}"]},
  {"cell_type":"markdown","metadata":{},"source":["## 1. Import Libraries"]},
  {"cell_type":"code","metadata":{},"outputs":[],"source":["import polars as pl\nimport polars.selectors as cs\nfrom sklearn.cluster import KMeans\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.decomposition import PCA\nfrom sklearn.metrics import silhouette_score\nfrom kneed import KneeLocator\nimport plotly.express as px\nimport numpy as np\nprint('Libraries loaded.')"],"execution_count":null},
  {"cell_type":"markdown","metadata":{},"source":["## 2. Load Data"]},
  {"cell_type":"code","metadata":{},"outputs":[],"source":["df = pl.read_csv('{{ dataset_name }}', skip_rows={{ skip_rows }})\nprint(f'{df.height:,} rows x {df.width} cols')"],"execution_count":null},
  {"cell_type":"markdown","metadata":{},"source":["## 3. Prepare + Scale"]},
  {"cell_type":"code","metadata":{},"outputs":[],"source":["X = df.select({{ features | tojson | replace('\"', '\\\"') }}).drop_nulls().to_numpy()\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\nprint(f'Shape: {X_scaled.shape}')"],"execution_count":null},
  {"cell_type":"markdown","metadata":{},"source":["## 4. Find Optimal K (Elbow)"]},
  {"cell_type":"code","metadata":{},"outputs":[],"source":["inertias = []\nks = range(2, min(11, len(X)))\nfor k in ks:\n    km = KMeans(n_clusters=k, random_state=42, n_init=10)\n    km.fit(X_scaled)\n    inertias.append(km.inertia_)\nkneedle = KneeLocator(list(ks), inertias, curve='convex', direction='decreasing')\nbest_k = kneedle.knee or 3\nprint(f'Best K: {best_k}')"],"execution_count":null},
  {"cell_type":"markdown","metadata":{},"source":["## 5. Train KMeans"]},
  {"cell_type":"code","metadata":{},"outputs":[],"source":["model = KMeans(n_clusters=best_k, random_state=42, n_init=10)\nlabels = model.fit_predict(X_scaled)\nprint(f'Silhouette: {silhouette_score(X_scaled, labels):.4f}')"],"execution_count":null},
  {"cell_type":"markdown","metadata":{},"source":["## 6. Results"]},
  {"cell_type":"code","metadata":{},"outputs":[],"source":["pca = PCA(n_components=2)\nX_2d = pca.fit_transform(X_scaled)\nfig = px.scatter(x=X_2d[:,0], y=X_2d[:,1], color=[str(l) for l in labels], title='Cluster View', template='plotly_dark')\nfig.show()"],"execution_count":null},
  {"cell_type":"code","metadata":{},"outputs":[],"source":["pl.DataFrame({'cluster': labels.tolist()}).write_csv('predictions.csv')\nprint('Saved.')"],"execution_count":null}
 ]
